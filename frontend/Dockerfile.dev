FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
# Keep completed downloads across build retries on unreliable connections.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund --prefer-offline --maxsockets=3 \
    --fetch-retries=3 --fetch-timeout=120000 --loglevel=http
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
